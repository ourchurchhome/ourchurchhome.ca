---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import HeroWidget from '../components/widgets/HeroWidget.astro';
import NewsWidget from '../components/widgets/NewsWidget.astro';
import VisionWidget from '../components/widgets/VisionWidget.astro';
import ChurchesWidget from '../components/widgets/ChurchesWidget.astro';
import { homepageSchema, bannerSchema } from '../content/schemas';
import { overrideForEntry, mergeDraftData, renderDraftMarkdown } from '../cms/lib/preview';

// ── Draft mode ────────────────────────────────────────────────────────────────
// The middleware verifies the CMS preview payload and puts it on
// Astro.locals.preview; overrides carry the in-flight values of the documents
// being edited. Absent a preview, published content renders as usual.
const preview = Astro.locals.preview ?? null;

// ── Banner singleton ──────────────────────────────────────────────────────────
const bannerEntries = await getCollection('banner');
const bannerEntry = bannerEntries[0];
const bannerOverride = overrideForEntry(preview, bannerEntry);
const bannerData =
  bannerEntry && bannerOverride
    ? mergeDraftData(bannerSchema, bannerEntry.data, bannerOverride)
    : bannerEntry?.data;
const bannerEnabled = bannerData?.enabled ?? false;
const bannerLink = bannerData?.link ?? null;

// A draft body bypasses the build, so it is rendered at request time.
const bannerDraftHtml =
  bannerOverride?.body !== undefined ? await renderDraftMarkdown(bannerOverride.body) : null;
const { Content: BannerContent } =
  bannerEntry && bannerDraftHtml === null ? await render(bannerEntry) : { Content: null };

// ── Homepage singleton ────────────────────────────────────────────────────────
const homepageEntries = await getCollection('homepage');
const homepage = homepageEntries[0];
const homepageOverride = overrideForEntry(preview, homepage);
const homepageData =
  homepage && homepageOverride
    ? mergeDraftData(homepageSchema, homepage.data, homepageOverride)
    : homepage?.data;

const widgets: NonNullable<ReturnType<typeof homepageSchema.parse>['widgets']> =
  homepageData?.widgets ?? [];
---

<BaseLayout title="Home" description="Mount Stewart, Morell, St. Peters Bay Pastoral Charge — ourchurchhome.ca">

  <!-- Banner -->
  {bannerEnabled && (BannerContent || bannerDraftHtml !== null) && (
    bannerLink ? (
      <a
        href={bannerLink}
        class="group flex items-center justify-center gap-2 bg-secondary text-on-secondary px-6 py-3 text-center text-sm font-medium leading-snug hover:bg-secondary-container transition-colors duration-200 [&_p]:inline [&_strong]:font-bold"
      >
        {bannerDraftHtml !== null ? <Fragment set:html={bannerDraftHtml} /> : BannerContent && <BannerContent />}
        <span class="material-symbols-outlined text-base shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">arrow_forward</span>
      </a>
    ) : (
      <div class="flex items-center justify-center bg-secondary text-on-secondary px-6 py-3 text-center text-sm font-medium leading-snug [&_p]:inline [&_strong]:font-bold">
        {bannerDraftHtml !== null ? <Fragment set:html={bannerDraftHtml} /> : BannerContent && <BannerContent />}
      </div>
    )
  )}

  <!-- Page sections — rendered in the order defined by homepage.json widgets -->
  {widgets.map((widget) => {
    if (widget.type === 'hero')     return <HeroWidget     {...widget} />;
    if (widget.type === 'news')     return <NewsWidget     {...widget} />;
    if (widget.type === 'vision')   return <VisionWidget   {...widget} />;
    if (widget.type === 'churches') return <ChurchesWidget {...widget} />;
    return null;
  })}


</BaseLayout>
